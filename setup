#!/usr/bin/env bash

# shellcheck disable=1091,2034,2068,2086

set -aeuo pipefail

# In all functions, make variables local unless they are either intended for global use, or set in
# a subshell that exits at the end of the function.

cleanup() {
  msg Cleaning conda cache
  conda clean --all --yes
  msg Purging pip cache
  pip cache purge
}

env_exists() {
  local d name x
  name=$1
  d=$INSTALLDIR/envs
  mkdir -p $d
  for x in $(find $d -maxdepth 1 -mindepth 1 -type d | sort); do
    if [[ $(basename $x) == "$name" ]]; then
      msg Found existing "'$name'" conda environment
      return 0
    fi
  done
  return 1
}

env_update() {

  # Update the environment with the given name, by default using an environment YAML file with the
  # same stem as the environment name, but optionally using the given stem (probably "dev"). Disable
  # unset-variable checking for various conda commands, which can otherwise trigger failures; reset
  # shell options after the update. Install pip packages separately, and only when the environment
  # name and YAML-file stem are the same. Compare environment revision history before and after the
  # update and report changed packages, if any.

  local list name new old opts stem
  name=$1
  stem=${2:-$name}
  msg Updating "'$name'" environment with "'$stem'" packages
  opts="$(set -e && shopt -po)"
  set +u
  list="conda list --name $name --canonical --quiet"
  old="$($list)"
  conda env update --file envs/$stem.yaml --name $name --quiet
  pip_install $name $stem
  new="$($list)"
  if [[ "$new" == "$old" ]]; then
    msg No changes detected
  else
    msg Changes from update:
    diff -U0 <(echo "$old") <(echo "$new") | sed -e '/^--- /d' -e '/^+++ /d' -e '/^@@ /d' || :
  fi
  eval "$opts"
}

install_conda() {
  local installer url ver
  if [[ -d $INSTALLDIR ]]; then
    msg Found existing conda installation: $INSTALLDIR
    return
  fi
  ver=26.9.4-1
  installer=Miniforge3-$ver-$(uname -s)-$(uname -p).sh
  url=https://github.com/conda-forge/miniforge/releases/download/$ver/$installer
  msg Installing conda
  wget -nv $url
  bash $installer -bfp $INSTALLDIR
  rm -v $installer
}

main() {

  # Set CONDA_OVERRIDE_CUDA to inform conda about the CUDA version to target. Set the conda install
  # directory, then install (a no-op if conda is already installed) and initialize. Set the cache
  # directory for pip package files. Prepare the conda environments, then clean up unused conda and
  # pip files.

  local environments name
  CONDA_OVERRIDE_CUDA=$(grep '^ *\- cuda-version=' envs/anemoi.yaml | sed 's/^[^=]*=//')
  INSTALLDIR=$(readlink -f ${INSTALLDIR:-$PWD/conda})
  install_conda
  . $INSTALLDIR/etc/profile.d/conda.sh
  XDG_CACHE_HOME=$_CONDA_ROOT/cache
  environments=(base)
  if [[ $# == 0 ]]; then
    environments+=(anemoi data visualization wxvx)
  else
    environments+=("$@")
  fi
  for name in ${environments[@]}; do
    time prep_$name
  done
  cleanup
  msg Done
}

msg() {
  echo -e "=> $*"
}

pip_install() {
  local cmd name reqs stem
  name=$1
  stem=$2
  reqs=envs/$stem.txt
  if [[ -f $reqs ]]; then
    msg Installing "'$stem'" pip packages into environment "'$name'"
    cmd="pip install --progress-bar off --requirement $reqs"
    conda run --live-stream --name $name $cmd | { grep --line-buffered -v "Requirement already satisfied" || :; }
  fi
}

prep_anemoi() {
  prep_env anemoi
}

prep_base() {
  local name
  name=base
  env_update $name
  if [[ -v EAGLEDEV ]]; then
    env_update $name dev
  fi
  if [[ -v EAGLE_CLEAN_CONDA_PKGS ]]; then
    cleanup
  fi
}

prep_data() {

  # Add logic to the [de]activation scripts to silence run-time complaints and avoid
  # segfaults when importing mpi4py in environments without InfiniBand hardware.

  local name
  name=data
  prep_env $name
  conda run --live-stream --name $name prep_data_post
}

prep_data_post() {
  local dir_activate dir_deactivate
  dir_activate=$CONDA_PREFIX/etc/conda/activate.d
  mkdir -pv $dir_activate
  cat <<EOF >>$CONDA_PREFIX/etc/conda/activate.d/eagle.sh # NB: append!
if [[ -v FI_PSM3_UUID ]]; then
  export EAGLE_OLD_FI_PSM3_UUID=\$FI_PSM3_UUID
fi
export FI_PSM3_UUID=eagle
if [[ -v FI_PROVIDER ]]; then
  export EAGLE_OLD_FI_PROVIDER=\$FI_PROVIDER
fi
export FI_PROVIDER=tcp
EOF
  dir_deactivate=$CONDA_PREFIX/etc/conda/deactivate.d
  mkdir -pv $dir_deactivate
  cat <<EOF >>$dir_deactivate/eagle.sh # NB: append!
unset FI_PSM3_UUID
if [[ -v EAGLE_OLD_FI_PSM3_UUID ]]; then
  export FI_PSM3_UUID=\$EAGLE_OLD_FI_PSM3_UUID
  unset EAGLE_OLD_FI_PSM3_UUID
fi
unset FI_PROVIDER
if [[ -v EAGLE_OLD_FI_PROVIDER ]]; then
  export FI_PROVIDER=\$EAGLE_OLD_FI_PROVIDER
  unset EAGLE_OLD_FI_PROVIDER
fi
EOF
}

prep_env() {

  # After creating or updating an environment, create scripts that [re]set XDG_CACHE_HOME when the
  # environment is [de]activated, so that pip caches package files in the runtime area, rather than
  # in the user's home directory, which might impact their quota. Always run this step to re-create
  # these scripts, as subsequent steps will *append* to them. In the subshell, set shell option e to
  # exit on any error and u to treat undefined variables as errors, as these are not propagated from
  # the parent shell.

  local name opts reqs
  name=$1
  if env_exists $name; then
    env_update $name
  else
    msg Creating "'$name'" conda environment
    opts="$(set -e && shopt -po)"
    set +u
    conda env create --file envs/$name.yaml --name $name --quiet --yes
    eval "$opts"
    pip_install $name $name
  fi
  if [[ -v EAGLEDEV ]]; then
    env_update $name dev
  fi
  conda run --live-stream --name $name prep_env_post
  if [[ -v EAGLE_CLEAN_CONDA_PKGS ]]; then
    cleanup
  fi
}

prep_env_post() {
  local dir_activate dir_deactivate
  dir_activate=$CONDA_PREFIX/etc/conda/activate.d
  mkdir -pv $dir_activate
  cat <<EOF >$dir_activate/eagle.sh
if [[ -v XDG_CACHE_HOME ]]; then
  export EAGLE_OLD_XDG_CACHE_HOME=\$XDG_CACHE_HOME
fi
export XDG_CACHE_HOME=$XDG_CACHE_HOME
EOF
  dir_deactivate=$CONDA_PREFIX/etc/conda/deactivate.d
  mkdir -pv $dir_deactivate
  cat <<EOF >$dir_deactivate/eagle.sh
unset XDG_CACHE_HOME
if [[ -v EAGLE_OLD_XDG_CACHE_HOME ]]; then
  export XDG_CACHE_HOME=\$EAGLE_OLD_XDG_CACHE_HOME
  unset EAGLE_OLD_XDG_CACHE_HOME
fi
EOF
}

prep_visualization() {
  prep_env visualization
}

prep_wxvx() {
  prep_env wxvx
}

time main "$@"
